{
  "name": "romanian-daily",
  "version": "1.0.0",
  "private": true,
  "description": "10 румынских слов в день — офлайн-first PWA",
  "scripts": {
    "dev": "node ./scripts/serve.mjs",
    "build": "npm run build:css && npm run build:icons",
    "build:css": "tailwindcss -i ./tailwind.css -o ./styles.css --minify",
    "watch:css": "tailwindcss -i ./tailwind.css -o ./styles.css --watch",
    "build:icons": "node ./scripts/generate-icons.mjs",
    "test": "node ./tests/validate-data.mjs && node ./tests/app.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  }
}
